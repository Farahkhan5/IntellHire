@model vision.Models.JobApplicationPageViewModel



@if (TempData["FormErrors"] != null)
{
    <div class="alert alert-danger">@TempData["FormErrors"]</div>
}
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>IntellHire</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="" name="keywords">
    <meta content="" name="description">
    <!-- Favicon -->
    <link href="img/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600&family=Inter:wght@700;800&display=swap" rel="stylesheet">

    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="~/lib/animate/animate.min.css" rel="stylesheet">
    <link href="~/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="~/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="~/css/style.css" rel="stylesheet">
</head>
<body>
    <div class="container-xxl bg-white p-0">
        @Html.Partial("User_Navbar")

        <div class="container-xxl py-5 bg-dark page-header mb-5">
            <div class="container my-5 pt-5 pb-4">
                <h1 class="display-3 text-white mb-3 animated slideInDown">Job Detail</h1>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb text-uppercase">
                        <li class="breadcrumb-item"><a href="#">Home</a></li>
                        <li class="breadcrumb-item"><a href="#">Pages</a></li>
                        <li class="breadcrumb-item text-white active" aria-current="page">Job Detail</li>
                    </ol>
                </nav>
            </div>
        </div>
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }
        <div class="container-xxl py-5 wow fadeInUp" data-wow-delay="0.1s">
            <div class="container">
                @{
                    var item = Model.JobDetail;
                }
                <div class="row gy-5 gx-4">
                    <div class="col-lg-8">

                        <div class="d-flex align-items-center mb-5">
                            @if (item != null && item.Company != null && !string.IsNullOrEmpty(item.Company.image)) 
                            {
                                <img src="~/img/@item.Company.image" class="flex-shrink-0 img-fluid border rounded" style="width: 80px; height: 80px;" alt="@item.Company.name" />
                            }
                            else
                            {
                                <img src="~/assets/img/default-company.png" class="img-fluid border rounded" style="width: 80px; height: 80px;" alt="No Company Image" />
                             }

                            @* @if (item.Company != null && !string.IsNullOrEmpty(item.Comany.image)) *@
                            @* { *@
                            @*     <img src="~/img/@item.Company.image" class="flex-shrink-0 img-fluid border rounded" style="width: 80px; height: 80px;" alt="@item.Company.name" /> *@
                            @* } *@
                            @* else *@
                            @* { *@
                            @*     <!-- fallback placeholder --> *@
                            @*     <img src="~/assets/img/default-company.png" class="img-responsive" alt="No Company Image" /> *@
                            @* } *@
                            <div class="text-start ps-4">
                                <h3 class="mb-3">@item.title</h3>
                                <span class="text-truncate me-3"><i class="fa fa-map-marker-alt text-primary me-2"></i>@item.address</span><br />
                                <span class="text-truncate me-3"><i class="far fa-clock text-primary me-2"></i>@item.type</span><br />
                                <span class="text-truncate me-0"><i class="far fa-money-bill-alt text-primary me-2"></i>@item.salary</span>
                            </div>
                        </div>

                        <div class="mb-5">
                            <h4 class="mb-3">Job Description</h4>
                            <p>@item.description</p>

                            <h4 class="mb-3">Responsibilities</h4>
                            <ul class="list-unstyled">
                                @* @foreach (var responsibility in item.responsibility?.Split('\n')) *@
                                @* { *@
                                @*     if (!string.IsNullOrWhiteSpace(responsibility)) *@
                                @*     { *@
                                @*         <li><i class="fa fa-angle-right text-primary me-2"></i>@responsibility</li> *@
                                @*     } *@
                                @* } *@
                                @if (item != null && !string.IsNullOrWhiteSpace(item.responsibility))
                                {
                                    var responsibilities = item.responsibility.Split('\n');
                                    foreach (var responsibility in responsibilities)
                                    {
                                       <li><i class="fa fa-angle-right text-primary me-2"></i>@responsibility</li> 
                                    }
                                }
                                else
                                {
                                    <li>No responsibilities provided.</li>
                                }
                            </ul>

                            <h4 class="mb-3">Qualifications</h4>
                            <ul class="list-unstyled">
                                @* @foreach (var qualification in item.qualifications?.Split('\n')) *@
                                @* { *@
                                @*     if (!string.IsNullOrWhiteSpace(qualification)) *@
                                @*     { *@
                                @*         <li><i class="fa fa-angle-right text-primary me-2"></i>@qualification</li> *@
                                @*     } *@
                                @* } *@
                                @if (item != null && !string.IsNullOrWhiteSpace(item.qualifications))
                                {
                                    var qualifications = item.qualifications.Split('\n');
                                    foreach (var qualification in qualifications)
                                    {
                                        if (!string.IsNullOrWhiteSpace(qualification))
                                        {
                                            <li><i class="fa fa-angle-right text-primary me-2"></i>@qualification</li>
                                        }
                                    }
                                }
                                else
                                {
                                    <li>No qualifications provided.</li>
                                }

                            </ul>
                        </div>

                        <div>
                            <h4 class="mb-4">Apply For The Job</h4>
                            <form method="post" asp-action="Job_detail" asp-controller="Home" enctype="multipart/form-data">
                                @Html.AntiForgeryToken()

                                <!-- Job ID (Hidden) -->
                                <input type="hidden" asp-for="Application.JobId" value="@Model.JobDetail.id" />
                                <div class="row g-3">
                                    <div class="col-12 col-sm-6">
                                        <input type="text" class="form-control" asp-for="Application.Name" placeholder="Your Name" />
                                        <span class="text-danger" asp-validation-for="Application.Name"></span>
                                    </div>
                                    <div class="col-12 col-sm-6">
                                        <input type="email" class="form-control" asp-for="Application.Email" placeholder="Your Email" />
                                        <span class="text-danger" asp-validation-for="Application.Email"></span>
                                    </div>
                                    <div class="col-12 col-sm-6">
                                        <input type="text" class="form-control" asp-for="Application.Qualification" placeholder="Qualification" />
                                        <span class="text-danger" asp-validation-for="Application.Qualification"></span>
                                    </div>
                                    <div class="col-12 col-sm-6">
                                        <input type="file" asp-for="Application.ResumeFile" class="form-control bg-white" />
                                        <span class="text-danger" asp-validation-for="Application.ResumeFile"></span>
                                    </div>
                                    <div class="col-12">
                                        <textarea class="form-control" rows="5" asp-for="Application.Message" placeholder="Cover Letter (optional)"></textarea>
                                        <span class="text-danger" asp-validation-for="Application.Message"></span>
                                    </div>
                                    <div class="col-12">
                                        <button class="btn btn-primary w-100" type="submit">Apply Now</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="bg-light rounded p-5 mb-4 wow slideInUp" data-wow-delay="0.1s">
                            <h4 class="mb-4">Job Summary</h4>
                            <p><i class="fa fa-angle-right text-primary me-2"></i>Published On: @item.CreatedAt</p>
                            <p><i class="fa fa-angle-right text-primary me-2"></i>Job Nature: @item.type</p>
                            <p><i class="fa fa-angle-right text-primary me-2"></i>Salary: @item.salary</p>
                            <p><i class="fa fa-angle-right text-primary me-2"></i>Location: @item.address</p>
                        </div>
                        <div class="bg-light rounded p-5 wow slideInUp" data-wow-delay="0.1s">
                            <h4 class="mb-4">Company Detail</h4>
                            <h5 class="mb-4">@(item.Company?.name ?? "Company name not available.")</h5>
                            <p class="m-0">@(item.Company?.description ?? "Company description not available.")</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
        <!--  Job end --->
        <!-- Footer Start -->
        <div class="container-fluid bg-dark text-white-50 footer pt-5 mt-5 wow fadeIn" data-wow-delay="0.1s">
            <div class="container py-5">
                <div class="row g-5">
                    <div class="col-lg-3 col-md-6">
                        <h5 class="text-white mb-4">Company</h5>
                        <a class="btn btn-link text-white-50" asp-controller="Home" asp-action="About">About Us</a>
                        <a class="btn btn-link text-white-50" asp-controller="Home" asp-action="Contact">Contact Us</a>
                        <a class="btn btn-link text-white-50" href="">Our Services</a>
                        <a class="btn btn-link text-white-50" href="">Privacy Policy</a>
                        <a class="btn btn-link text-white-50" href="">Terms & Condition</a>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <h5 class="text-white mb-4">Quick Links</h5>
                        <a class="btn btn-link text-white-50" asp-controller="Home" asp-action="About">About Us</a>
                        <a class="btn btn-link text-white-50" asp-controller="Home" asp-action="Contact">Contact Us</a>
                        <a class="btn btn-link text-white-50" href="">Our Services</a>
                        <a class="btn btn-link text-white-50" href="">Privacy Policy</a>
                        <a class="btn btn-link text-white-50" href="">Terms & Condition</a>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <h5 class="text-white mb-4">Contact</h5>
                        <p class="mb-2"><i class="fa fa-map-marker-alt me-3"></i>143, North Nazimabad, Karachi</p>
                        <p class="mb-2"><i class="fa fa-phone-alt me-3"></i>+12 345 67890</p>
                        <p class="mb-2"><i class="fa fa-envelope me-3"></i>info@example.com</p>
                        <div class="d-flex pt-2">
                            <a class="btn btn-outline-light btn-social" href="https://x.com/"><i class="fab fa-twitter"></i></a>
                            <a class="btn btn-outline-light btn-social" href="https://www.facebook.com/"><i class="fab fa-facebook-f"></i></a>
                            <a class="btn btn-outline-light btn-social" href="https://www.youtube.com/"><i class="fab fa-youtube"></i></a>
                            <a class="btn btn-outline-light btn-social" href="https://pk.linkedin.com/"><i class="fab fa-linkedin-in"></i></a>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <h5 class="text-white mb-4">Newsletter</h5>
                        <p>Dolor amet sit justo amet elitr clita ipsum elitr est.</p>

                        @using (Html.BeginForm("SubscribeEmail", "Home", FormMethod.Post))
                        {
                            <div class="position-relative mx-auto" style="max-width: 400px;">
                                <input name="email" class="form-control bg-transparent w-100 py-3 ps-4 pe-5"
                                       type="email" placeholder="Your email" required />
                                <button type="submit" class="btn btn-primary py-2 position-absolute top-0 end-0 mt-2 me-2">
                                    Subscribe
                                </button>
                            </div>
                        }

                        @if (TempData["Message"] != null)
                        {
                            <div class="alert alert-info mt-3">@TempData["Message"]</div>
                        }
                    </div>

                </div>
            </div>

        </div>
        <!-- Footer End -->
        <!-- Back to Top -->
        <a href="#" class="btn btn-lg btn-primary btn-lg-square back-to-top"><i class="bi bi-arrow-up"></i></a>
    </div>

    <!-- JavaScript Libraries -->
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="lib/wow/wow.min.js"></script>
    <script src="lib/easing/easing.min.js"></script>
    <script src="lib/waypoints/waypoints.min.js"></script>
    <script src="lib/owlcarousel/owl.carousel.min.js"></script>

    <!-- Template Javascript -->
    <script src="js/main.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const filterButtons = document.querySelectorAll('[data-filter]');
            const jobItems = document.querySelectorAll('#jobs-container .job-item');

            filterButtons.forEach(btn => {
                btn.addEventListener('click', function () {
                    const filter = this.getAttribute('data-filter');

                    jobItems.forEach(job => {
                        const jobType = job.getAttribute('data-job-type');

                        if (filter === 'featured') {
                            // Featured click hone par sab jobs dikhani hain
                            job.style.display = '';
                        }
                        else {
                            job.style.display = (jobType === filter) ? '' : 'none';
                        }
                    });

                    // Active class toggle
                    filterButtons.forEach(b => b.classList.remove('active'));
                    this.classList.add('active');
                });
            });
        });
    </script>

</body>
</html>

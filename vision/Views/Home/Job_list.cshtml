@model IEnumerable<vision.Models.Job>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <title>IntellHire</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="" name="keywords">
    <meta content="" name="description">

    <!-- Favicon -->
    <link href="img/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600&family=Inter:wght@700;800&display=swap" rel="stylesheet">

    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="~/lib/animate/animate.min.css" rel="stylesheet">
    <link href="~/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="~/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="~/css/style.css" rel="stylesheet">
</head>

<body>
    <div class="container-xxl bg-white p-0 ">

        <!-- Navbar Start -->
        @Html.Partial("User_Navbar")
        <!-- Navbar End -->
        <!-- Header End -->
        <div class=" container-xxl py-5 bg-dark page-header mb-5">
            <div class="container my-5 pt-5 pb-4">
                <h1 class="display-3 text-white mb-3 animated slideInDown">Job List</h1>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb text-uppercase">
                        <li class="breadcrumb-item"><a href="#">Home</a></li>
                        <li class="breadcrumb-item"><a href="#">Pages</a></li>
                        <li class="breadcrumb-item text-white active" aria-current="page">Job List</li>
                    </ol>
                </nav>
            </div>
        </div>
        <!-- Header End -->

        <!-- Jobs Start -->
        <div class="container-xxl py-5">
            <div class="container">
                <h1 class="text-center mb-5 wow fadeInUp" data-wow-delay="0.1s">Job Listing</h1>

                    <div class="container mt-4">

                    <div class="search-container" style="margin-bottom: 15px; margin-left:60%;">
                        <input type="text" id="searchBox" class="btn outline-primary" placeholder="Search..." style="padding:8px; width:300px; border:1px solid #00B074;">
                        <button id="searchBtn"  class="btn btn-primary" style="padding:8px;  color:white; border:none; width:80px;">Go</button>
                    </div>

                <div class="tab-class text-center wow fadeInUp" data-wow-delay="0.3s">
                        <ul class="nav nav-pills d-inline-flex justify-content-center border-bottom mb-5">
                            <li class="nav-item">
                                <a class="d-flex align-items-center text-start mx-3 ms-0 pb-3 active" data-bs-toggle="pill" data-filter="featured" href="javascript:void(0);">
                                    <h6 class="mt-n1 mb-0">Featured</h6>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="d-flex align-items-center text-start mx-3 pb-3" data-bs-toggle="pill" data-filter="Full Time" href="javascript:void(0);">
                                    <h6 class="mt-n1 mb-0">Full Time</h6>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="d-flex align-items-center text-start mx-3 me-0 pb-3" data-bs-toggle="pill" data-filter="Part Time" href="javascript:void(0);">
                                    <h6 class="mt-n1 mb-0">Part Time</h6>
                                </a>
                            </li>
                        </ul>
                        <div class="tab-content" id="jobs-container">

                        <div id="tab-1" class="tab-pane fade show p-0 active">
                            <article>
                                @foreach (var item in Model)
                                {
                                        <div class="job-item p-4 mb-4" data-job-type="@item.type" data-featured="false">
                                        <div class="row g-4">
                                            <div class="col-sm-12 col-md-8 d-flex align-items-center">
                                                @if (item.Company != null && !string.IsNullOrEmpty(item.Company.image))
                                                {
                                                    <img src="~/img/@item.Company.image" class="flex-shrink-0 img-fluid border rounded" style="width: 80px; height: 80px;" alt="@item.Company.name" />
                                                }
                                                else
                                                {
                                                    <!-- fallback placeholder -->
                                                    <img src="~/assets/img/default-company.png" class="img-responsive" alt="No Company Image" />
                                                }
                                            <div class="text-start ps-4" >
                                                    <h5 class="mb-3">@item.title</h5>
                                                    <span class="text-truncate me-3"><i class="fa fa-map-marker-alt text-primary me-2"></i>@item.address</span>
                                                    <span class="text-truncate me-3"><i class="far fa-clock text-primary me-2"></i>@item.type</span>
                                                    <span class="text-truncate me-0"><i class="far fa-money-bill-alt text-primary me-2"></i>@item.salary</span>
                                                </div>
                                            </div>
                                            <div class="col-sm-12 col-md-4 d-flex flex-column align-items-start align-items-md-end justify-content-center">
                                                <div class="d-flex mb-3">
                                                    <a class="btn btn-light btn-square me-3" href=""><i class="far fa-heart text-primary"></i></a>
                                                    <a class="btn btn-primary" asp-action="Job_detail" asp-route-id="@item.id">Apply Now</a>
                                                </div>
                                                <small class="text-truncate"><i class="far fa-calendar-alt text-primary me-2"></i>@item.CreatedAt.ToString("yyyy-MM-dd")</small>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </article>
                 
                            <a class="btn btn-primary py-3 px-5" href="">Browse More Jobs</a> 
                      </div>
                    </div> 
                </div>
            </div>
        </div>
        </div>
        <!-- Jobs End -->
            <!-- Footer Start -->
            <div class="container-fluid bg-dark text-white-50 footer pt-5 mt-5 wow fadeIn" data-wow-delay="0.1s">
                <div class="container py-5">
                    <div class="row g-5">
                        <div class="col-lg-3 col-md-6">
                            <h5 class="text-white mb-4">Company</h5>
                            <a class="btn btn-link text-white-50" asp-controller="Home" asp-action="About">About Us</a>
                            <a class="btn btn-link text-white-50" asp-controller="Home" asp-action="Contact">Contact Us</a>
                            <a class="btn btn-link text-white-50" href="">Our Services</a>
                            <a class="btn btn-link text-white-50" href="">Privacy Policy</a>
                            <a class="btn btn-link text-white-50" href="">Terms & Condition</a>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <h5 class="text-white mb-4">Quick Links</h5>
                            <a class="btn btn-link text-white-50" asp-controller="Home" asp-action="About">About Us</a>
                            <a class="btn btn-link text-white-50" asp-controller="Home" asp-action="Contact">Contact Us</a>
                            <a class="btn btn-link text-white-50" href="">Our Services</a>
                            <a class="btn btn-link text-white-50" href="">Privacy Policy</a>
                            <a class="btn btn-link text-white-50" href="">Terms & Condition</a>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <h5 class="text-white mb-4">Contact</h5>
                            <p class="mb-2"><i class="fa fa-map-marker-alt me-3"></i>143, North Nazimabad, Karachi</p>
                            <p class="mb-2"><i class="fa fa-phone-alt me-3"></i>+12 345 67890</p>
                            <p class="mb-2"><i class="fa fa-envelope me-3"></i>info@example.com</p>
                            <div class="d-flex pt-2">
                                <a class="btn btn-outline-light btn-social" href="https://x.com/"><i class="fab fa-twitter"></i></a>
                                <a class="btn btn-outline-light btn-social" href="https://www.facebook.com/"><i class="fab fa-facebook-f"></i></a>
                                <a class="btn btn-outline-light btn-social" href="https://www.youtube.com/"><i class="fab fa-youtube"></i></a>
                                <a class="btn btn-outline-light btn-social" href="https://pk.linkedin.com/"><i class="fab fa-linkedin-in"></i></a>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <h5 class="text-white mb-4">Newsletter</h5>
                            <p>Dolor amet sit justo amet elitr clita ipsum elitr est.</p>

                            @using (Html.BeginForm("SubscribeEmail", "Home", FormMethod.Post))
                            {
                                <div class="position-relative mx-auto" style="max-width: 400px;">
                                    <input name="email" class="form-control bg-transparent w-100 py-3 ps-4 pe-5"
                                           type="email" placeholder="Your email" required />
                                    <button type="submit" class="btn btn-primary py-2 position-absolute top-0 end-0 mt-2 me-2">
                                        Subscribe
                                    </button>
                                </div>
                            }

                            @if (TempData["Message"] != null)
                            {
                                <div class="alert alert-info mt-3">@TempData["Message"]</div>
                            }
                        </div>

                    </div>
                </div>

            </div>
            <!-- Footer End -->
            <!-- Back to Top -->
            <a href="#" class="btn btn-lg btn-primary btn-lg-square back-to-top"><i class="bi bi-arrow-up"></i></a>
        </div>
      

        <!-- JavaScript Libraries -->
        <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/lib/wow/wow.min.js"></script>
        <script src="~/lib/easing/easing.min.js"></script>
        <script src="~/lib/waypoints/waypoints.min.js"></script>
        <script src="~/lib/owlcarousel/owl.carousel.min.js"></script>

        <!-- Template Javascript -->
        <script src="~/js/main.js"></script>

        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const filterButtons = document.querySelectorAll('[data-filter]');
                const jobItems = document.querySelectorAll('#jobs-container .job-item');

                filterButtons.forEach(btn => {
                    btn.addEventListener('click', function () {
                        const filter = this.getAttribute('data-filter');

                        jobItems.forEach(job => {
                            const jobType = job.getAttribute('data-job-type');

                            if (filter === 'featured') {
                                // Featured click hone par sab jobs dikhani hain
                                job.style.display = '';
                            }
                            else {
                                job.style.display = (jobType === filter) ? '' : 'none';
                            }
                        });

                        // Active class toggle
                        filterButtons.forEach(b => b.classList.remove('active'));
                        this.classList.add('active');
                    });
                });
            });
        </script>


        <script>
            const searchBox = document.getElementById("searchBox");

            searchBox.addEventListener("keyup", function () {
                let searchValue = this.value.toLowerCase().trim();
                let jobs = document.querySelectorAll(".job-item");

                jobs.forEach(job => {
                    let titleElement = job.querySelector("h5");
                    let titleText = titleElement ? titleElement.textContent.toLowerCase() : "";

                    // Agar box empty hai ya match mil raha hai to show karo
                    if (searchValue === "" || titleText.includes(searchValue)) {
                        job.style.display = "";
                    } else {
                        job.style.display = "none";
                    }
                });
            });
        </script>


</body>

</html>
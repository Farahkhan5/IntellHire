<head>
	<!-- Basic Page Needs
	================================================== -->
	<title>Job Stock - Responsive Job Portal Bootstrap Template</title>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
</head>
<body>
	<div class="Loader"></div>
	<div class="wrapper">

		<!-- Start Navigation -->
		@Html.Partial("Recruiter_Navbar")
		<!-- End Navigation -->
		<div class="clearfix"></div>

		<!-- Header Title Start -->
		<section class="inner-header-title blank">
			<div class="container">
				<h1>Edit Company</h1>
			</div>
		</section>
		<div class="clearfix"></div>
		<!-- Header Title End -->
		<!-- General Detail Start -->
		<div class="detail-desc section">
			<div class="container white-shadow">
				<div class="row">
					<div class="detail-pic js">
						<div class="box">
							<input type="file" name="upload-pic[]" id="upload-pic" class="inputfile" />
							<label for="upload-pic"><i class="fa fa-upload" aria-hidden="true"></i><span></span></label>
						</div>
					</div>
				</div>

				<div class="row bottom-mrg">

					<form class="add-feild" method="post" enctype="multipart/form-data">

						<div class="col-md-6 col-sm-6">
							<div class="input-group">
								<input type="hidden" asp-for="id" id="id" value="@Model.id" class="form-control" placeholder="Company Name">
							</div>

							<div class="input-group">
								<input type="text" asp-for="name" id="name" value="@Model.name" class="form-control" placeholder="Company Name">
								<span class="text-danger" asp-validation-for="name"></span>
							</div>
						</div>

						<div class="col-md-6 col-sm-6">
							<div class="input-group">
								<input type="text" asp-for="tagline" id="tagline" value="@Model.tagline" class="form-control" placeholder="Company Tagline">
								<span class="text-danger" asp-validation-for="tagline"></span>
							</div>
						</div>

						<div class="col-md-6 col-sm-6">
							<div class="input-group">
								<input type="text" asp-for="category" id="category" value="@Model.category" class="form-control" placeholder="Category">
								<span class="text-danger" asp-validation-for="category"></span>
							</div>
						</div>

						<div class="col-md-6 col-sm-6">
							<div class="input-group">
								<input type="text" asp-for="CEO" id="CEO" value="@Model.CEO" class="form-control" placeholder="Company CEO Name">
								<span class="text-danger" asp-validation-for="CEO"></span>
							</div>
						</div>

						<div class="col-md-6 col-sm-6">
							<div class="input-group">
								<input type="text" asp-for="email" id="email" value="@Model.email" class="form-control" placeholder="Email Address">
								<span class="text-danger" asp-validation-for="email"></span>
							</div>
						</div>

						<div class="col-md-6 col-sm-6">
							<div class="input-group">
								<input type="text" asp-for="address" id="address" value="@Model.address" class="form-control" placeholder="Company Address">
								<span class="text-danger" asp-validation-for="address"></span>
							</div>
						</div>

						<div class="col-md-12 col-sm-12">
							<textarea class="form-control" asp-for="description" value="@Model.description" id="description" placeholder="Company Description"></textarea>
							<span class="text-danger" asp-validation-for="description"></span>
						</div>

						<div class="row no-padd">
							<div class="detail pannel-footer">
								@if (!string.IsNullOrEmpty(Model.image))
{
    <div class="mb-3">
        <img src="~/img/@Model.image" />
        <input type="hidden" name="OldImage" value="@Model.image" />
    </div>
}

<div class="col-md-12  mb-3">
    <label>Change Image (optional)</label>
    <input type="file" name="image" class="form-control-file" />
    <span class="text-danger" asp-validation-for="image"></span>
</div>


							</div>
						</div>

						<div class="row no-padd">
							<div class="detail pannel-footer">
								<div class="col-md-12 col-sm-12 text-center">
									<div class="detail-pannel-footer-btn">
										<button type="submit" class="btn btn-primary justify-content-center align-items-center mx-auto">Submit</button>
									</div>
								</div>
							</div>
						</div>

					</form>
				</div>

			</div>
		</div>
		<!-- General Detail End -->
		<!-- Footer Section Start -->
		<footer class="footer">
			<div class="row lg-menu">
				<div class="container">
					<div class="col-md-4 col-sm-4">

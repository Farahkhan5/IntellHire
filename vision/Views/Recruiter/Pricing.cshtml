<div class="container text-center">
    <h2>Company Creation Pricing</h2>
    <p>
        To create a company, you agree to give
        <strong>@ViewBag.CommissionPercent %</strong> of each payment to the admin.
    </p>

    <form method="post" asp-action="AcceptPricing">
        <button type="submit" class="btn btn-success">I Agree & Continue</button>
    </form>
</div>

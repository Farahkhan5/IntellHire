			<span class="text-danger" asp-validation-for="responsibility"></span>
		</div>
	</div>

	<!-- Description -->
	<div class="col-md-6 col-sm-6">
		<div class="input-group">
			<textarea asp-for="description" id="description" class="form-control" placeholder="Job Description"></textarea>

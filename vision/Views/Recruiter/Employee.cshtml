			});
		</script>
		<script>
			function openRightMenu() {
				document.getElementById("rightMenu").style.display = "block";
			}

			function closeRightMenu() {
				document.getElementById("rightMenu").style.display = "none";
			}
		</script>

		<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

		<script>
			$(document).ready(function () {
				$('.status-dropdown').change(function () {
					var candidateId = $(this).data('id');
					var newStatus = $(this).val();

					$.ajax({
						url: '/Recruiter/UpdateApplicationStatus',
						type: 'POST',
						data: { id: candidateId, status: newStatus },
						success: function (res) {
							updateStatusBadge(candidateId, newStatus);

						},
						error: function () {
							alert('Error updating status');
						}
					});
				});
			});

			function updateStatusBadge(appId, newStatus) {
				var badge = document.getElementById("status-badge-" + appId);
				if (!badge) return;

				let colorMap = {
					"Interview": "#28a745",
					"Pending": "#fd7e14",
					"Rejected": "#dc3545",
					"Hired": "#007bff"
				};

				badge.textContent = newStatus;
				badge.style.background = colorMap[newStatus] || "#6c757d";
			}
		</script>


		<script>
			const searchBox = document.getElementById("searchBox");

			searchBox.addEventListener("keyup", function () {
				let searchValue = this.value.toLowerCase().trim();
				let jobCards = document.querySelectorAll(".jn-employee");

				jobCards.forEach(job => {
					// Job title text
					let titleElement = job.querySelector(".designation");
					let titleText = titleElement ? titleElement.textContent.toLowerCase() : "";

					// Status badge text
					let statusElement = job.querySelector(".status-badge");
					let statusText = statusElement ? statusElement.textContent.toLowerCase() : "";

					// Combine for searching
					let combinedText = titleText + " " + statusText;

					if (searchValue === "" || combinedText.includes(searchValue)) {
						job.parentElement.style.display = ""; // col-md-4 ko show kare
					} else {
						job.parentElement.style.display = "none"; // col-md-4 ko hide kare
					}
				});
			});
		</script>


	</div>
</body>


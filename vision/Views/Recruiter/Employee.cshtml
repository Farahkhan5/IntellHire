	<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">

</head>
<body>
	<div class="Loader"></div>
	<div class="wrapper">

		<!-- Start Navigation -->
		@Html.Partial("Recruiter_Navbar")
		<!-- End Navigation -->
		<div class="clearfix"></div>

		<!-- Title Header Start -->
		<section class="inner-header-title" style="background-image:url('/assets/img/banner-10.jpg');">
			<div class="container">
				<h1>Manage Employee</h1>
			</div>
		</section>
		<div class="clearfix"></div>
		<!-- Title Header End -->
		<!-- Employee list start -->
		<section class="manage-employee gray">
			<div class="container">
				<!-- search filter -->
				<div class="row">
					<div class="col-md-12 col-sm-12">
						<div class="search-filter">

							<div class="col-md-4 col-sm-5">
								<div class="filter-form">
									<div class="input-group">
										<input type="text" id="searchBox" class="form-control" placeholder="Search…">
										<span class="input-group-btn">
											<button type="button" class="btn btn-default">Go</button>
										</span>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
				<!-- search filter End -->
				<!-- Manage Employee -->
				@Html.AntiForgeryToken()

				<div class="row">
					@foreach (var app in Model)
					{
						<div class="col-md-4 col-sm-6">
							<div class="jn-employee">

								<!-- Top row: Badge Left & Dropdown Right -->
								<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
									<!-- Status Badge -->
									@{
										var color = app.ApplicationStatus == "Interview" ? "#28a745" :
										app.ApplicationStatus == "Pending" ? "#fd7e14" :
										app.ApplicationStatus == "Rejected" ? "#dc3545" :
										app.ApplicationStatus == "Hired" ? "#007bff" :
										"#6c757d";
									}
									<span class="status-badge" id="status-badge-@app.Id"
										  style="background:@color; color:white; padding:4px 8px; border-radius:4px;">
										@app.ApplicationStatus
									</span>

									<!-- Dropdown -->
									<select class="form-control status-dropdown" data-id="@app.Id" style="width:auto;">
										<option value="" selected disabled>Select Option</option>
										<option value="Pending" selected="@(app.ApplicationStatus == "Pending")">Pending</option>
										<option value="Interview" selected="@(app.ApplicationStatus == "Interview")">Interview</option>
										<option value="Hired" selected="@(app.ApplicationStatus == "Hired")">Hired</option>
										<option value="Rejected" selected="@(app.ApplicationStatus == "Rejected")">Rejected</option>
									</select>
								</div>

								<!-- Candidate Info -->
								<div class="employee-caption">
									<div class="employee-caption-pic">
										<img src="@(!string.IsNullOrEmpty(app.ProfileImagePath)
                                        ? app.ProfileImagePath
                                        : Url.Content("~/assets/img/default-profile.png"))"
											 class="img-responsive rounded-circle"
											 style="width:120px; height:120px; object-fit:cover;"
											 alt="@app.Name" />
									</div>


									<h4>@app.Name</h4>
									<span class="designation">@app.JobTitle</span>
									<br />
									<a href="@app.ResumeFilePath" class="btn btn-success" download>
										<i class="fa fa-download"></i> Download Resume
									</a>
								</div>
							</div>
						</div>
					}

				</div>

		</section>
		<!-- Employee List End -->
		<!-- Footer Section Start -->
		<footer class="footer">

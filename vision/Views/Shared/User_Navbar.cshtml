@inject IHttpContextAccessor HttpContextAccessor

<!-- Navbar Start -->
<nav class="navbar navbar-expand-lg bg-white navbar-light shadow sticky-top p-0">
    <a href="index.html" class="navbar-brand d-flex align-items-center text-center py-0 px-4 px-lg-5">
        <h1 class="m-0 text-primary">IntellHire</h1>
    </a>
    <button type="button" class="navbar-toggler me-4" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
        <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarCollapse">
        <div class="navbar-nav ms-auto p-4 p-lg-0">
            <a asp-controller="Home" asp-action="Index" class="nav-item nav-link active">Home</a>
            <a asp-controller="Home" asp-action="About" class="nav-item nav-link">About</a>
            <div class="nav-item dropdown">
                <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">Jobs</a>
                <div class="dropdown-menu rounded-0 m-0">
                    <a asp-controller="Home" asp-action="Job_list" class="dropdown-item">Job List</a>
                    
                </div>
            </div>

            <a asp-controller="Home" asp-action="Contact" class="nav-item nav-link">Contact</a>
            @if (!string.IsNullOrEmpty(HttpContextAccessor.HttpContext.Session.GetString("Name")))
            {
                <!-- Agar login hai -->
               
                <a asp-controller="Home" asp-action="Profile" class="nav-item nav-link ">Profile</a>
                <a asp-controller="Home" asp-action="Registerout" class="nav-item nav-link ">Sign Out</a>

            }
            else
            {
                <!-- Agar login nahi hai -->
                <a asp-controller="Home" asp-action="Register" class="nav-item nav-link ">Sign In</a>
            }
        </div>
        <a asp-controller="Recruiter" asp-action="Signup" class="btn btn-primary rounded-0 py-4 px-lg-5 d-none d-lg-block">Post A Job<i class="fa fa-arrow-right ms-3"></i></a>
    </div>
</nav>
<!-- Navbar End -->